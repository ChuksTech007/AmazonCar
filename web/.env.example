# Local only. Do not set PORT on Vercel — the platform assigns it.
PORT=8787

# Local: http://localhost:5173
# Vercel: https://web-theta-sepia-99.vercel.app  (no trailing slash)
PUBLIC_URL=http://localhost:5173
ADMIN_USER=amason
ADMIN_PASS=KenyaDoor2026
ADMIN_SECRET=change-this-secret

# MongoDB — listings, enquiries, cruise packages. Leave empty to keep the local JSON store.
MONGODB_URI=mongodb://127.0.0.1:27017/amason

# Cloudinary — car and cruise photos, auction-sheet PDFs. Leave empty to store resized local WebP.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# or: CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME

# Desk ping when a public enquiry lands. Copy real values into .env (gitignored).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
NOTIFY_WEBHOOK_URL=
